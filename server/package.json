    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "sanitize-html": "2.13.1",
