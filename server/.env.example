# Server Environment Configuration

# Server Port
PORT=5000

# Environment: development | production
NODE_ENV=development

# MongoDB Connection String (e.g., mongodb://localhost:27017/mydiary or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/mydiary

# JWT Secret for signing auth tokens (minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_characters_long

# JWT expiration duration (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cloudinary Configuration for Media Uploads (Free tier)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Encryption at Rest (AES-256-GCM)
# 32-byte secret key (64 hex characters). Never ship or commit a default key.
# Generate your key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Back up this key safely. If this key is lost, encrypted entries cannot be recovered.
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_KEY_HERE

# Google Gemini AI Configuration (Server-only, never expose to frontend)
# Obtain an API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Model name (e.g. gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro)
# set GEMINI_MODEL to a name printed by npm run ai:check
GEMINI_MODEL=gemini-2.5-flash
# Use 'paid' only if the Google Cloud project has billing enabled.
GEMINI_TIER=free
# Set to true only for demos with fake/non-personal data when GEMINI_TIER=free in production
ALLOW_FREE_TIER_DIARY_AI=false

# Optional SMTP Email Configuration (Nodemailer for Password Reset)
# If omitted or unconfigured in development, reset links are printed to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="MindDiary" <support@minddiary.app>
