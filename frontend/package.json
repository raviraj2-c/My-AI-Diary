{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\" --names \"🚀SERVER,💻CLIENT\" --prefix-colors \"blue,green\"",
    "server:dev": "cd server && npm run dev",
    "server:install": "cd server && npm install",
    "server:prod": "cd server && npm run prod",
    "build": "vite build",
    "build:server": "cd server && npm install --production",
    "start": "npm run server:prod",
    "deploy": "npm run build && npm run build:server",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:client && npm run test:server",
    "test:client": "vitest",
    "test:server": "cd server && npm test"
  },
  "dependencies": {
    "@tiptap/extension-image": "^2.25.0",
    "@tiptap/extension-placeholder": "^2.25.0",
    "@tiptap/react": "^2.25.0",
    "@tiptap/starter-kit": "^2.25.0",
    "date-fns": "^4.1.0",
    "html2pdf.js": "^0.10.3",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-calendar": "^6.0.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.43.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
